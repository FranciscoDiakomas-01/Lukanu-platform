generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ROLE {
  ADMIN
  REGULAR
}

enum PAYSTATUS {
  PAID
  CANCELED
  PENDING
  REJECTED
}

enum LEVEL {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum STATUS {
  ACTIVED
  DESACTIVED
  PENDING
}

model User {
  id                     Int           @id @default(autoincrement())
  firstName              String
  lastName               String
  email                  String        @unique
  password               String
  phone                  String?       @unique
  profileUrl             String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  iban String? @unique
  bank String?
  role ROLE @default(REGULAR)
  status                 STATUS        @default(ACTIVED)
  
  totalErned             Int           @default(0)
  totalAvaliable         Int           @default(0)
  totalTaked             Int           @default(0)
  totalCourses           Int           @default(0)
  totalBooks             Int           @default(0)
  totalPendingPurchase   Int           @default(0)
  totalActiveCourses     Int           @default(0)
  totalDesactivedCourses Int           @default(0)
  totalUnreadNotification Int          @default(0)

  Ebooks                 Ebook[]
  Courses                Course[]
  Purschases             Purschase[]
  Notifications          Notification[]
  MessagesSent           Message[]     @relation("SentMessages")
  MessagesReceived       Message[]     @relation("ReceivedMessages")
  Afiliations Afiliations[]
}


model Course {
  id             Int             @id @default(autoincrement())
  ownerId        Int
  title          String
  description    String
  videoURl       String
  category       String
  price          Int
  level          LEVEL
  formLink  String?
  isPublished Boolean @default(false)
  totalLessons   Int             @default(0)
  totalModules Int @default(0)
  totalStudents  Int             @default(0)
  tags           String[]
  rating         Float?
  status         STATUS          @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  Subscriptions  Subscription[]
  Modules Module[]
  Chats          Chat[]
  @@unique([title, level, ownerId])
}

model Module {
  id          Int      @id @default(autoincrement())
  title String
  description String
  video String
  totalLessons Int @default(0)
  order Int
  Lessons        Lesson[]
  courseId Int

  course Course @relation(references: [id] , fields: [courseId] , onDelete: Cascade)

}

model Lesson {
  id          Int      @id @default(autoincrement())
  moduleId    Int
  order       Int
  title       String
  description String
  videoURl    String
  tags        String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Subscription {
  id          Int       @id @default(autoincrement())
  courseId    Int
  userId      Int
  status      STATUS    @default(PENDING)
  amount      Int
  file        String
  expiredAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Ebook {
  id             Int       @id @default(autoincrement())
  code String @unique 
  title          String
  subtitle       String?
  description    String?
  coverUrl       String?
  fileURl        String
  checkoutURL String
  metaData       Json?
  currentPrice   Int
  oldProce       Int      @default(0)
  isShared       Boolean    @default(false)
  isDigital Boolean @default(true)
  sharePercent   Int @default(0)
  language       String     @default("pt")
  rating         Int @default(0)
  views Int @default(0)
  purshases Int @default(0)
  pages          Int
  category       String
  edition        Int        @default(1)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  authorId       Int
  author         User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  Purschases     Purschase[]
  Afiliations Afiliations[]
}

model Afiliations {
  id Int @id @default(autoincrement())
  link String
  userid Int
  bookId Int
  purchaseCount Int @default(0)
  purchases Int @default(0)
  ebook Ebook @relation(fields: [bookId] , references: [id] , onDelete: Cascade)
  user User @relation(fields: [userid] , references: [id] , onDelete: Cascade)
}

model Purschase {
  id         Int        @id @default(autoincrement())
  ownerId    Int
  buyerId    Int?
  ebookId    Int
  price Int
  payed Int
  afiliationCode String?
  description String?
  fileUrl    String
  digital Boolean
  status     PAYSTATUS   @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ebook      Ebook       @relation(fields: [ebookId], references: [id], onDelete: Cascade)
}

model Notification {
  id          Int        @id @default(autoincrement())
  userId      Int
  title       String
  message     String
  read        Boolean     @default(false)
  deepLink String?
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Chat {
  id          Int        @id @default(autoincrement())
  courseId    Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  messages    Message[]
}

model Message {
  id          Int       @id @default(autoincrement())
  chatId      Int
  senderId    Int
  receiverId  Int
  content     String
  createdAt   DateTime  @default(now())
  chat        Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}
